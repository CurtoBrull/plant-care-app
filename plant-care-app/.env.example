# =============================================================================
# VARIABLES DE ENTORNO - PLANT CARE APP
# =============================================================================

# 1. Base de Datos (Neon PostgreSQL)
DATABASE_URL=postgresql://neondb_owner:<password>@<endpoint>.eu-central-1.aws.neon.tech/neondb?sslmode=require

# 2. Autenticación (JWT Session Secret)
JWT_SECRET=tu-clave-secreta-para-firmar-tokens-jwt

# 3. Almacenamiento de Fotos (Vercel Blob - se añade automáticamente en Vercel)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# 4. Inteligencia Artificial (Google Gemini o OpenRouter)
GEMINI_API_KEY=<gemini-api-key>
OPENROUTER_API_KEY=

# 5. Notificaciones y Vercel Cron
CRON_SECRET=<random-secret>
FCM_SERVER_KEY=<fcm-server-key>
